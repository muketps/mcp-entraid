{
  "$schema": "https://gofastmcp.com/public/schemas/fastmcp.json/v1.json",
  "source": {
    "path": "src/mcp_entraid/server.py",
    "entrypoint": "mcp"
  },
  "environment": {
    "type": "uv",
    "python": "3.11",
    "dependencies": [
      "fastmcp>=2.12.0",
      "httpx>=0.27.0",
      "pydantic>=2.7.0",
      "pydantic-settings>=2.2.0",
      "python-dotenv>=1.0.1"
    ]
  },
  "deployment": {
    "transport": "stdio",
    "log_level": "INFO"
  }
}
